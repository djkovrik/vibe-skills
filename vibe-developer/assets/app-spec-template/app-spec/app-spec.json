{
  "schemaVersion": "2.0",
  "app": {
    "name": "Example App",
    "summary": "A validated hand-off example.",
    "targets": [
      "android",
      "ios"
    ],
    "locales": [
      "en",
      "ru"
    ]
  },
  "requirements": [
    {
      "id": "REQ-001",
      "title": "Persist the selected preference",
      "priority": "must",
      "status": "approved",
      "acceptanceScenarioIds": [
        "AC-001",
        "AC-002",
        "AC-003"
      ]
    }
  ],
  "acceptanceScenarios": [
    {
      "id": "AC-001",
      "title": "Save the first preference selection",
      "requirementId": "REQ-001",
      "flowId": "FLOW-001",
      "screenIds": [
        "SCREEN-001"
      ],
      "kind": "action",
      "subject": "PreferenceSelection",
      "operation": "create",
      "verificationSurfaces": [
        "component-test",
        "settings-integration-test"
      ],
      "dependsOnAcceptanceScenarioIds": []
    },
    {
      "id": "AC-002",
      "title": "Restore the persisted preference selection",
      "requirementId": "REQ-001",
      "flowId": "FLOW-001",
      "screenIds": [
        "SCREEN-001"
      ],
      "kind": "state",
      "subject": "PreferenceSelection",
      "operation": "read",
      "verificationSurfaces": [
        "component-test",
        "settings-integration-test"
      ],
      "dependsOnAcceptanceScenarioIds": [
        "AC-001"
      ]
    },
    {
      "id": "AC-003",
      "title": "Replace a saved preference selection",
      "requirementId": "REQ-001",
      "flowId": "FLOW-001",
      "screenIds": [
        "SCREEN-001"
      ],
      "kind": "action",
      "subject": "PreferenceSelection",
      "operation": "update",
      "verificationSurfaces": [
        "component-test",
        "settings-integration-test"
      ],
      "dependsOnAcceptanceScenarioIds": [
        "AC-001"
      ]
    }
  ],
  "managedEntities": [
    {
      "entity": "PreferenceSelection",
      "operations": {
        "create": {
          "status": "required",
          "acceptanceScenarioIds": [
            "AC-001"
          ]
        },
        "read": {
          "status": "required",
          "acceptanceScenarioIds": [
            "AC-002"
          ]
        },
        "update": {
          "status": "required",
          "acceptanceScenarioIds": [
            "AC-003"
          ]
        },
        "delete": {
          "status": "not-applicable",
          "reason": "The product always keeps one selection and exposes no clear/reset action."
        }
      }
    }
  ],
  "qualityGates": [
    {
      "id": "QG-001",
      "title": "Repository tests and static checks",
      "category": "repository",
      "platform": "all",
      "requirement": "required",
      "verificationMethod": "Run the focused test, Detekt, Kover, and build tasks declared in quality.md.",
      "contractSource": "quality.md#test-matrix",
      "verificationSurfaces": [
        "repository-check"
      ]
    },
    {
      "id": "QG-002",
      "title": "Android build and platform checks",
      "category": "platform",
      "platform": "android",
      "requirement": "required",
      "verificationMethod": "Run the declared Android build and platform test tasks.",
      "contractSource": "quality.md#release-acceptance",
      "verificationSurfaces": [
        "android-build"
      ]
    },
    {
      "id": "QG-003",
      "title": "iOS compilation and platform checks",
      "category": "platform",
      "platform": "ios",
      "requirement": "required",
      "verificationMethod": "Run the declared iOS compilation and platform test tasks.",
      "contractSource": "quality.md#release-acceptance",
      "verificationSurfaces": [
        "ios-build"
      ]
    },
    {
      "id": "QG-004",
      "title": "Release acceptance",
      "category": "release",
      "platform": "all",
      "requirement": "required",
      "verificationMethod": "Verify every release acceptance item and its current evidence.",
      "contractSource": "quality.md#release-acceptance",
      "verificationSurfaces": [
        "release-check"
      ]
    },
    {
      "id": "QG-005",
      "title": "External publication configuration",
      "category": "external",
      "platform": "all",
      "requirement": "conditional",
      "condition": "A distribution build is being published to an external store or service.",
      "verificationMethod": "Verify the configured external account, credentials, and publication result.",
      "contractSource": "quality.md#release-acceptance",
      "verificationSurfaces": [
        "publication-check"
      ]
    },
    {
      "id": "QG-006",
      "title": "Asset creation and production usage",
      "category": "repository",
      "platform": "all",
      "requirement": "required",
      "verificationMethod": "Run validate-assets.py, compile Compose Resources and inspect production preview/golden evidence for every ASSET ID.",
      "contractSource": "quality.md#asset-delivery",
      "verificationSurfaces": [
        "asset-check",
        "asset-visual"
      ]
    }
  ],
  "flows": [
    "FLOW-001"
  ],
  "screens": [
    "SCREEN-001"
  ],
  "capabilities": {
    "network": false,
    "database": false,
    "settings": true,
    "sync": false,
    "authentication": false,
    "notifications": false,
    "exactAlarms": false,
    "ads": false
  },
  "constraints": {
    "offlineMode": "The preference remains available offline.",
    "privacy": [
      "Do not collect personal data."
    ],
    "accessibility": [
      "Support screen readers and font scaling."
    ],
    "performance": [
      "Persist the preference without visible delay."
    ]
  },
  "localization": {
    "defaultLocale": "en",
    "localeSelection": "system-only",
    "resourceSystem": "compose-multiplatform-resources",
    "resourceFileFormat": "strings.xml",
    "keyStrategy": "shared-key-across-locales",
    "localDataTextStorage": "resource-keys-only",
    "nativeFallback": "platform-localized-resources",
    "hardcodedUserFacingStrings": false
  },
  "architecture": {
    "resultType": "kotlin-result",
    "componentModel": "immutable-value",
    "stateOwner": "mvikotlin-store",
    "stateMapping": "store-state-to-component-model",
    "storeDataAccess": "manager-result-unwrap",
    "managerResultCapture": "runCatching",
    "previewComponent": "separate-preview-implementation",
    "componentModuleStrategy": "screen-or-flow-boundary",
    "screenshotTestHost": "compose-ui-module",
    "screenshotTestHostRationale": "The Compose module owns production previews, theme, fonts, resources, generated Android unit tests, and snapshots."
  },
  "uiQuality": {
    "previewThemes": [
      "light",
      "dark"
    ],
    "fontScales": [
      1.0,
      2.0
    ],
    "localeCoverage": "all",
    "goldenTesting": {
      "required": true,
      "engine": "paparazzi",
      "previewDiscovery": "ComposablePreviewScanner"
    },
    "designReview": {
      "required": true,
      "provider": "lazyweb",
      "trigger": "after-goldens",
      "standards": [
        "material3"
      ]
    },
    "iconography": {
      "inventoryStatus": "approved",
      "standardIconSource": "Material Symbols",
      "customAssetsStatus": "not-required"
    }
  },
  "openQuestions": [],
  "assetRequirements": {
    "resourceSystem": "compose-multiplatform-resources",
    "deliveryManifest": "docs/assets/asset-manifest.json",
    "qualityGateId": "QG-006",
    "items": [
      {
        "id": "ASSET-001",
        "kind": "icon",
        "acquisition": "reuse",
        "brief": "Canonical Material Symbols back action with meaningful RTL mirroring.",
        "screenIds": [
          "SCREEN-001"
        ],
        "acceptanceScenarioIds": [
          "AC-001"
        ],
        "resourceName": "ic_arrow_back",
        "displayDp": [
          24,
          24
        ],
        "maxDensity": 4,
        "transparent": true,
        "themeBehavior": "Shared tintable vector in light/dark themes.",
        "tintBehavior": "Material content color.",
        "accessibility": "Localized action semantics; do not duplicate adjacent text.",
        "variants": [
          {
            "path": "shared/compose/src/commonMain/composeResources/drawable/ic_arrow_back.xml"
          }
        ]
      },
      {
        "id": "ASSET-002",
        "kind": "icon",
        "acquisition": "reuse",
        "brief": "Canonical Material Symbols save action matching the same outlined icon family.",
        "screenIds": [
          "SCREEN-001"
        ],
        "acceptanceScenarioIds": [
          "AC-001"
        ],
        "resourceName": "ic_save",
        "displayDp": [
          24,
          24
        ],
        "maxDensity": 4,
        "transparent": true,
        "themeBehavior": "Shared tintable vector in light/dark themes.",
        "tintBehavior": "Material content color.",
        "accessibility": "Localized action semantics; do not duplicate adjacent text.",
        "variants": [
          {
            "path": "shared/compose/src/commonMain/composeResources/drawable/ic_save.xml"
          }
        ]
      }
    ]
  }
}
