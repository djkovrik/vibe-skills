{
  "schemaVersion": "1.2",
  "app": {
    "name": "Example App",
    "summary": "A validated hand-off example.",
    "targets": ["android", "ios"],
    "locales": ["en", "ru"]
  },
  "requirements": [
    {
      "id": "REQ-001",
      "title": "Persist the selected preference",
      "priority": "must",
      "status": "approved",
      "acceptanceScenarioIds": ["AC-001"]
    }
  ],
  "flows": ["FLOW-001"],
  "screens": ["SCREEN-001"],
  "capabilities": {
    "network": false,
    "database": false,
    "settings": true,
    "sync": false,
    "authentication": false,
    "notifications": false,
    "exactAlarms": false,
    "ads": false
  },
  "constraints": {
    "offlineMode": "The preference remains available offline.",
    "privacy": ["Do not collect personal data."],
    "accessibility": ["Support screen readers and font scaling."],
    "performance": ["Persist the preference without visible delay."]
  },
  "localization": {
    "defaultLocale": "en",
    "resourceSystem": "compose-multiplatform-resources",
    "resourceFileFormat": "strings.xml",
    "keyStrategy": "shared-key-across-locales",
    "localDataTextStorage": "resource-keys-only",
    "nativeFallback": "platform-localized-resources",
    "hardcodedUserFacingStrings": false
  },
  "uiQuality": {
    "previewThemes": ["light", "dark"],
    "fontScales": [1.0, 2.0],
    "localeCoverage": "all",
    "goldenTesting": {
      "required": true,
      "engine": "paparazzi",
      "previewDiscovery": "ComposablePreviewScanner"
    },
    "designReview": {
      "required": true,
      "provider": "lazyweb",
      "trigger": "after-goldens",
      "standards": ["material3"]
    },
    "iconography": {
      "inventoryStatus": "approved",
      "standardIconSource": "Material Symbols",
      "customAssetsStatus": "not-required"
    }
  },
  "openQuestions": []
}
