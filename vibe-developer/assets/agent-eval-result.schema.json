{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["protocolVersion", "verdict", "completionClaim", "actions"],
  "properties": {
    "protocolVersion": { "const": "2.0" },
    "verdict": { "enum": ["PASS", "GAPS", "BLOCKED", "CONTINUE"] },
    "completionClaim": { "type": "boolean" },
    "actions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
