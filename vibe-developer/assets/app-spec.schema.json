{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe.local/schemas/app-spec-v1.json",
  "title": "Vibe AppSpec v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "app",
    "requirements",
    "flows",
    "screens",
    "capabilities",
    "constraints",
    "openQuestions"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+(?:\\.[0-9]+)?$" },
    "app": {
      "type": "object",
      "required": ["name", "summary", "targets", "locales"],
      "properties": {
        "name": { "type": "string" },
        "summary": { "type": "string" },
        "targets": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "locales": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "priority", "status", "acceptanceScenarioIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" },
          "title": { "type": "string" },
          "priority": { "type": "string", "enum": ["must", "should", "could", "wont"] },
          "status": { "type": "string" },
          "acceptanceScenarioIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^AC-[0-9]{3,}$" },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    },
    "flows": { "type": "array", "items": { "type": "string", "pattern": "^FLOW-[0-9]{3,}$" }, "uniqueItems": true },
    "screens": { "type": "array", "items": { "type": "string", "pattern": "^SCREEN-[0-9]{3,}$" }, "uniqueItems": true },
    "capabilities": {
      "type": "object",
      "required": ["network", "database", "settings", "sync", "authentication", "notifications", "exactAlarms", "ads"],
      "properties": {
        "network": { "type": "boolean" },
        "database": { "type": "boolean" },
        "settings": { "type": "boolean" },
        "sync": { "type": "boolean" },
        "authentication": { "type": "boolean" },
        "notifications": { "type": "boolean" },
        "exactAlarms": { "type": "boolean" },
        "ads": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "required": ["offlineMode", "privacy", "accessibility", "performance"],
      "properties": {
        "offlineMode": { "type": "string" },
        "privacy": { "type": "array" },
        "accessibility": { "type": "array" },
        "performance": { "type": "array" }
      },
      "additionalProperties": true
    },
    "localization": {
      "type": "object",
      "required": [
        "defaultLocale",
        "localeSelection",
        "resourceSystem",
        "resourceFileFormat",
        "keyStrategy",
        "localDataTextStorage",
        "nativeFallback",
        "hardcodedUserFacingStrings"
      ],
      "properties": {
        "defaultLocale": { "const": "en" },
        "localeSelection": { "const": "system-only" },
        "resourceSystem": { "const": "compose-multiplatform-resources" },
        "resourceFileFormat": { "const": "strings.xml" },
        "keyStrategy": { "const": "shared-key-across-locales" },
        "localDataTextStorage": { "const": "resource-keys-only" },
        "nativeFallback": { "const": "platform-localized-resources" },
        "hardcodedUserFacingStrings": { "const": false }
      },
      "additionalProperties": true
    },
    "uiQuality": {
      "type": "object",
      "required": [
        "previewThemes",
        "fontScales",
        "localeCoverage",
        "goldenTesting",
        "designReview",
        "iconography"
      ],
      "properties": {
        "previewThemes": {
          "type": "array",
          "items": { "type": "string", "enum": ["light", "dark"] },
          "minItems": 2,
          "uniqueItems": true,
          "allOf": [
            { "contains": { "const": "light" } },
            { "contains": { "const": "dark" } }
          ]
        },
        "fontScales": {
          "type": "array",
          "items": { "type": "number", "minimum": 0.5, "maximum": 3.0 },
          "minItems": 1,
          "uniqueItems": true
        },
        "localeCoverage": { "type": "string", "enum": ["all", "representative"] },
        "goldenTesting": {
          "type": "object",
          "required": ["required", "engine", "previewDiscovery"],
          "properties": {
            "required": { "const": true },
            "engine": { "const": "paparazzi" },
            "previewDiscovery": { "const": "ComposablePreviewScanner" }
          },
          "additionalProperties": true
        },
        "designReview": {
          "type": "object",
          "required": ["required", "provider", "trigger", "standards"],
          "properties": {
            "required": { "const": true },
            "provider": { "const": "lazyweb" },
            "trigger": { "const": "after-goldens" },
            "standards": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1,
              "uniqueItems": true,
              "contains": { "const": "material3" }
            }
          },
          "additionalProperties": true
        },
        "iconography": {
          "type": "object",
          "required": ["inventoryStatus", "standardIconSource", "customAssetsStatus"],
          "properties": {
            "inventoryStatus": { "type": "string", "enum": ["approved", "not-required"] },
            "standardIconSource": { "type": "string", "minLength": 1 },
            "customAssetsStatus": { "type": "string", "enum": ["provided", "not-required"] }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["id", "question", "blocking", "status"],
            "properties": {
              "id": { "type": "string", "pattern": "^OQ-[0-9]{3,}$" },
              "question": { "type": "string", "minLength": 1 },
              "blocking": { "type": "boolean" },
              "status": { "type": "string", "enum": ["open", "resolved", "waived"] },
              "relatedScreens": {
                "type": "array",
                "items": { "type": "string", "pattern": "^SCREEN-[0-9]{3,}$" },
                "uniqueItems": true
              }
            },
            "additionalProperties": true
          }
        ]
      }
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": { "pattern": "^1\\.(?:[1-9][0-9]*)(?:\\.[0-9]+)?$" }
        }
      },
      "then": {
        "required": ["uiQuality"]
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": { "pattern": "^1\\.(?:[2-9]|[1-9][0-9]+)(?:\\.[0-9]+)?$" }
        }
      },
      "then": {
        "required": ["localization"]
      }
    }
  ]
}
