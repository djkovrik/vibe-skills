{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe.local/schemas/app-spec-v1.4.json",
  "title": "Vibe AppSpec v1.4 (with legacy 1.x compatibility)",
  "type": "object",
  "required": ["schemaVersion", "app", "requirements", "flows", "screens", "capabilities", "constraints", "openQuestions"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-4](?:\\.[0-9]+)?$" },
    "app": {
      "type": "object",
      "required": ["name", "summary", "targets", "locales"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "targets": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "locales": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "priority", "status", "acceptanceScenarioIds"],
        "properties": {
          "id": { "$ref": "#/$defs/requirementId" },
          "title": { "type": "string", "minLength": 1 },
          "priority": { "type": "string", "enum": ["must", "should", "could", "wont"] },
          "status": { "type": "string", "minLength": 1 },
          "acceptanceScenarioIds": { "type": "array", "items": { "$ref": "#/$defs/acceptanceId" }, "minItems": 1, "uniqueItems": true }
        },
        "additionalProperties": true
      }
    },
    "acceptanceScenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "requirementId", "flowId", "screenIds", "kind", "subject", "operation", "verificationSurfaces"],
        "properties": {
          "id": { "$ref": "#/$defs/acceptanceId" },
          "title": { "type": "string", "minLength": 1 },
          "requirementId": { "$ref": "#/$defs/requirementId" },
          "flowId": { "$ref": "#/$defs/flowId" },
          "screenIds": { "type": "array", "items": { "$ref": "#/$defs/screenId" }, "minItems": 1, "uniqueItems": true },
          "kind": { "type": "string", "enum": ["action", "state", "failure"] },
          "subject": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "minLength": 1 },
          "verificationSurfaces": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
          "reviewStatus": { "type": "string", "enum": ["approved", "needs-review"] }
        },
        "additionalProperties": true
      }
    },
    "managedEntities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity", "operations"],
        "properties": {
          "entity": { "type": "string", "minLength": 1 },
          "operations": {
            "type": "object",
            "required": ["create", "read", "update", "delete"],
            "properties": {
              "create": { "$ref": "#/$defs/operationDecision" },
              "read": { "$ref": "#/$defs/operationDecision" },
              "update": { "$ref": "#/$defs/operationDecision" },
              "delete": { "$ref": "#/$defs/operationDecision" }
            },
            "additionalProperties": { "$ref": "#/$defs/operationDecision" }
          }
        },
        "additionalProperties": true
      }
    },
    "qualityGates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "category", "platform", "requirement", "verificationMethod", "contractSource"],
        "properties": {
          "id": { "$ref": "#/$defs/qualityGateId" },
          "title": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "enum": ["repository", "platform", "external", "release"] },
          "platform": { "type": "string", "minLength": 1 },
          "requirement": { "type": "string", "enum": ["required", "conditional"] },
          "condition": { "type": "string", "minLength": 1 },
          "verificationMethod": { "type": "string", "minLength": 1 },
          "contractSource": { "type": "string", "minLength": 1 }
        },
        "allOf": [{ "if": { "properties": { "requirement": { "const": "conditional" } }, "required": ["requirement"] }, "then": { "required": ["condition"] } }],
        "additionalProperties": true
      }
    },
    "flows": { "type": "array", "items": { "$ref": "#/$defs/flowId" }, "uniqueItems": true },
    "screens": { "type": "array", "items": { "$ref": "#/$defs/screenId" }, "uniqueItems": true },
    "capabilities": {
      "type": "object",
      "required": ["network", "database", "settings", "sync", "authentication", "notifications", "exactAlarms", "ads"],
      "properties": {
        "network": { "type": "boolean" }, "database": { "type": "boolean" }, "settings": { "type": "boolean" }, "sync": { "type": "boolean" },
        "authentication": { "type": "boolean" }, "notifications": { "type": "boolean" }, "exactAlarms": { "type": "boolean" }, "ads": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "required": ["offlineMode", "privacy", "accessibility", "performance"],
      "properties": { "offlineMode": { "type": "string" }, "privacy": { "type": "array" }, "accessibility": { "type": "array" }, "performance": { "type": "array" } },
      "additionalProperties": true
    },
    "localization": {
      "type": "object",
      "required": ["defaultLocale", "localeSelection", "resourceSystem", "resourceFileFormat", "keyStrategy", "localDataTextStorage", "nativeFallback", "hardcodedUserFacingStrings"],
      "properties": {
        "defaultLocale": { "const": "en" }, "localeSelection": { "const": "system-only" }, "resourceSystem": { "const": "compose-multiplatform-resources" },
        "resourceFileFormat": { "const": "strings.xml" }, "keyStrategy": { "const": "shared-key-across-locales" }, "localDataTextStorage": { "const": "resource-keys-only" },
        "nativeFallback": { "const": "platform-localized-resources" }, "hardcodedUserFacingStrings": { "const": false }
      },
      "additionalProperties": true
    },
    "architecture": {
      "type": "object",
      "required": ["resultType", "componentModel", "stateOwner", "stateMapping", "storeDataAccess", "managerResultCapture", "previewComponent", "componentModuleStrategy", "screenshotTestHost", "screenshotTestHostRationale"],
      "properties": {
        "resultType": { "const": "kotlin-result" }, "componentModel": { "const": "immutable-value" }, "stateOwner": { "const": "mvikotlin-store" },
        "stateMapping": { "const": "store-state-to-component-model" }, "storeDataAccess": { "const": "manager-result-unwrap" }, "managerResultCapture": { "const": "runCatching" },
        "previewComponent": { "const": "separate-preview-implementation" }, "componentModuleStrategy": { "const": "screen-or-flow-boundary" },
        "screenshotTestHost": { "type": "string", "enum": ["compose-ui-module", "dedicated-android-host-module"] },
        "screenshotTestHostRationale": { "type": "string", "minLength": 20 }
      },
      "additionalProperties": true
    },
    "uiQuality": {
      "type": "object",
      "required": ["previewThemes", "fontScales", "localeCoverage", "goldenTesting", "designReview", "iconography"],
      "properties": {
        "previewThemes": { "type": "array", "items": { "type": "string", "enum": ["light", "dark"] }, "minItems": 2, "uniqueItems": true, "allOf": [{ "contains": { "const": "light" } }, { "contains": { "const": "dark" } }] },
        "fontScales": { "type": "array", "items": { "type": "number", "minimum": 0.5, "maximum": 3.0 }, "minItems": 1, "uniqueItems": true },
        "localeCoverage": { "type": "string", "enum": ["all", "representative"] },
        "goldenTesting": { "type": "object", "required": ["required", "engine", "previewDiscovery"], "properties": { "required": { "const": true }, "engine": { "const": "paparazzi" }, "previewDiscovery": { "const": "ComposablePreviewScanner" } }, "additionalProperties": true },
        "designReview": { "type": "object", "required": ["required", "provider", "trigger", "standards"], "properties": { "required": { "const": true }, "provider": { "const": "lazyweb" }, "trigger": { "const": "after-goldens" }, "standards": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true, "contains": { "const": "material3" } } }, "additionalProperties": true },
        "iconography": { "type": "object", "required": ["inventoryStatus", "standardIconSource", "customAssetsStatus"], "properties": { "inventoryStatus": { "type": "string", "enum": ["approved", "not-required"] }, "standardIconSource": { "type": "string", "minLength": 1 }, "customAssetsStatus": { "type": "string", "enum": ["provided", "not-required"] } }, "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "type": "object", "required": ["id", "question", "blocking", "status"], "properties": { "id": { "type": "string", "pattern": "^OQ-[0-9]{3,}$" }, "question": { "type": "string", "minLength": 1 }, "blocking": { "type": "boolean" }, "status": { "type": "string", "enum": ["open", "resolved", "waived"] }, "relatedScreens": { "type": "array", "items": { "$ref": "#/$defs/screenId" }, "uniqueItems": true } }, "additionalProperties": true }
        ]
      }
    }
  },
  "$defs": {
    "requirementId": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" },
    "flowId": { "type": "string", "pattern": "^FLOW-[0-9]{3,}$" },
    "screenId": { "type": "string", "pattern": "^SCREEN-[0-9]{3,}$" },
    "acceptanceId": { "type": "string", "pattern": "^AC-[0-9]{3,}$" },
    "qualityGateId": { "type": "string", "pattern": "^QG-[0-9]{3,}$" },
    "operationDecision": {
      "oneOf": [
        { "type": "object", "required": ["status", "acceptanceScenarioIds"], "properties": { "status": { "const": "required" }, "acceptanceScenarioIds": { "type": "array", "items": { "$ref": "#/$defs/acceptanceId" }, "minItems": 1, "uniqueItems": true } }, "additionalProperties": true },
        { "type": "object", "required": ["status", "reason"], "properties": { "status": { "const": "not-applicable" }, "reason": { "type": "string", "minLength": 1 } }, "additionalProperties": true }
      ]
    }
  },
  "additionalProperties": true,
  "allOf": [
    { "if": { "properties": { "schemaVersion": { "pattern": "^1\\.(?:[1-4])(?:\\.[0-9]+)?$" } } }, "then": { "required": ["uiQuality"] } },
    { "if": { "properties": { "schemaVersion": { "pattern": "^1\\.(?:[2-4])(?:\\.[0-9]+)?$" } } }, "then": { "required": ["localization"] } },
    { "if": { "properties": { "schemaVersion": { "pattern": "^1\\.(?:[3-4])(?:\\.[0-9]+)?$" } } }, "then": { "required": ["architecture"] } },
    { "if": { "properties": { "schemaVersion": { "pattern": "^1\\.4(?:\\.[0-9]+)?$" } } }, "then": { "required": ["acceptanceScenarios", "managedEntities", "qualityGates"] } }
  ]
}
